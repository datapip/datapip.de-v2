# SMTP credentials for the contact form (src/lib/contact.ts).
# Without these the form renders and validates, but reports a
# configuration error instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
TO_EMAIL=

# PocketBase — only used by /api/feedback, which the two browser extensions
# call. Without these the feedback is still emailed; only the database write
# is skipped.
PB_ENDPOINT=
PB_USER=
PB_PASSWORD=

# Only set this if Chromium refuses to start on the host (running as root,
# or a container without user namespaces). The sandbox is this process
# strongest defence, because the scanner opens URLs chosen by strangers.
# SCANNER_NO_SANDBOX=true
