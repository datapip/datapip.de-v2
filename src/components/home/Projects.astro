---
import { Image } from "astro:assets";
import Section from "../Section.astro";
import { sections, type Locale } from "../../i18n/ui";
import { portfolio } from "../../i18n/portfolio";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = portfolio[lang].projects;
const id = sections[lang].projects;
---

<Section id={id} eyebrow={t.eyebrow} heading={t.heading} lede={t.lede}>
  <ul class="grid gap-px bg-rule md:grid-cols-2">
    {
      t.items.map((project) => (
        <li class="group flex flex-col bg-ground">
          {/* These product shots were drawn for a light page. Held just
               below full brightness so they sit in the dark ground instead
               of glaring out of it, and restored on hover. */}
          <Image
            src={project.image}
            alt={project.title}
            widths={[400, 800, 1200]}
            sizes="(min-width: 768px) 50vw, 100vw"
            format="avif"
            loading="lazy"
            decoding="async"
            class="aspect-video w-full border-b border-rule object-cover brightness-[0.88] saturate-[0.92] transition duration-300 group-hover:brightness-100 group-hover:saturate-100"
          />

          <div class="flex flex-1 flex-col p-6 md:p-8">
            <h3 class="text-h3 font-semibold">{project.title}</h3>

            <p class="mt-3 flex-1 text-[0.94rem] text-fg-muted">
              {project.description}
            </p>

            <ul class="mt-6 flex flex-wrap gap-2">
              {project.technologies.map((tech) => (
                <li class="border border-rule px-2 py-1 font-mono text-[0.7rem] text-fg-faint">
                  {tech}
                </li>
              ))}
            </ul>

            <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-rule pt-5">
              <a
                href={project.primaryLink}
                class="label inline-block py-1.5 text-signal transition-colors hover:text-fg"
                rel={
                  project.primaryLink.startsWith("http")
                    ? "noopener noreferrer"
                    : undefined
                }
                target={
                  project.primaryLink.startsWith("http") ? "_blank" : undefined
                }
              >
                {project.primaryText} &rarr;
              </a>

              {project.secondaryLink && (
                <a
                  href={project.secondaryLink}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="label inline-block py-1.5 text-fg-muted transition-colors hover:text-fg"
                >
                  {project.secondaryText} &rarr;
                </a>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
