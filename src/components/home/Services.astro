---
import Section from "../Section.astro";
import { ui, sections, routes, type Locale } from "../../i18n/ui";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang].services;
const id = sections[lang].services;
const r = routes[lang];
---

<Section id={id} eyebrow={t.eyebrow} heading={t.heading} lede={t.lede}>
  {/* Numbered because it is a real sequence: debug, then set up, then
       hand over the tools. Not decoration. */}
  <ol class="grid gap-px bg-rule md:grid-cols-3">
    {
      t.items.map((item, i) => (
        <li class="flex flex-col bg-ground p-6 md:p-8">
          <span class="label text-signal">
            {String(i + 1).padStart(2, "0")}
          </span>

          <h3 class="mt-4 text-h3 font-semibold">{item.title}</h3>

          <p class="mt-3 flex-1 text-[0.94rem] text-fg-muted">{item.body}</p>

          <ul class="mt-6 flex flex-wrap gap-2">
            {item.tags.map((tag) => (
              <li class="border border-rule px-2 py-1 font-mono text-[0.7rem] text-fg-faint">
                {tag}
              </li>
            ))}
          </ul>

          {/* The homepage previously linked nowhere from its body — every
              route was reachable only through the nav. A card that names a
              tool should be the path to it, for a reader and for a crawler. */}
          {"links" in item && (
            <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 border-t border-rule pt-5">
              {item.links.map((link) => (
                <li>
                  <a
                    href={`/${lang}/${r[link.route as keyof typeof r]}/`}
                    class="label inline-block py-1.5 text-signal transition-colors hover:text-fg"
                  >
                    {link.label} &rarr;
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ol>
</Section>
