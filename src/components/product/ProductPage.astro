---
/**
 * Shared layout for both product pages.
 *
 * Rebuilt on Instrument tokens rather than transliterated from v1's Shadcn
 * card/accordion structure: the feature grid is the hairline grid used by
 * Projects.astro, the steps reuse the mono index from the legal clauses, and
 * the FAQ is native <details>/<summary> so the page still ships zero JS.
 */
import { Image, getImage } from "astro:assets";

import Base from "../../layouts/Base.astro";
import Section from "../Section.astro";
import type { Product } from "../../i18n/products";
import type { Locale } from "../../i18n/ui";

interface Props {
  lang: Locale;
  product: Product;
  image: ImageMetadata;
}

const { lang, product, image } = Astro.props;
const p = product;

const canonical = new URL(`/${lang}/${p.slug}/`, Astro.site).href;

/* Social scrapers are unreliable with WebP, so the share image is rendered
   as JPEG. The on-page <Image> stays AVIF like everywhere else. */
const share = await getImage({
  src: image,
  format: "jpeg",
  width: 1200,
  height: 675,
});

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: p.schema.name,
      description: p.schema.description,
      applicationCategory: p.schema.applicationCategory,
      applicationSubCategory: p.schema.applicationSubCategory,
      operatingSystem: p.schema.operatingSystem,
      url: canonical,
      image: new URL(share.src, Astro.site).href,
      author: {
        "@type": "Person",
        name: "Philipp Jäckle",
        url: Astro.site?.href.replace(/\/$/, ""),
      },
      offers: {
        "@type": "Offer",
        url: p.gumroadUrl,
        seller: { "@type": "Person", name: "Philipp Jäckle" },
      },
      featureList: p.schema.featureList,
      keywords: p.schema.keywords,
    },
    {
      /* v1 had a middle "Products" crumb pointing at /{lang}/products, which
         has never existed. Dropped rather than ported — a breadcrumb item
         must be a real URL. */
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: p.schema.breadcrumbHome,
          item: new URL(`/${lang}/`, Astro.site).href,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: p.schema.name,
          item: canonical,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: p.faq.items.map(({ q, a }) => ({
        "@type": "Question",
        name: q,
        acceptedAnswer: { "@type": "Answer", text: a },
      })),
    },
  ],
};

const ctaRel = "noopener noreferrer";
---

<Base
  lang={lang}
  title={p.meta.title}
  description={p.meta.description}
  keywords={p.meta.keywords}
  ogImage={{
    src: new URL(share.src, Astro.site).href,
    alt: p.imageAlt,
    width: 1200,
    height: 675,
  }}
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  {/* Hero */}
  <section class="mx-auto max-w-[1280px] px-5 pt-16 pb-4 md:px-8 md:pt-24">
    <div class="max-w-[62ch]">
      <p class="label text-signal">{p.eyebrow}</p>
      <h1 class="mt-4 text-display font-semibold">{p.h1}</h1>
      <p class="mt-6 text-lede text-fg-muted">{p.tagline}</p>

      <ul class="mt-8 flex flex-wrap gap-2">
        {
          p.badges.map((badge) => (
            <li class="border border-rule px-2 py-1 font-mono text-[0.7rem] text-fg-faint">
              {badge}
            </li>
          ))
        }
      </ul>

      <a
        href={p.gumroadUrl}
        target="_blank"
        rel={ctaRel}
        data-umami-event="link_open"
        data-umami-event-name={p.umamiName}
        data-umami-event-type="product-hero-cta"
        class="label mt-10 inline-block bg-signal px-6 py-4 text-signal-ink transition-colors hover:bg-signal-hover"
      >
        {p.cta} &rarr;
      </a>
    </div>

    <div class="mt-14 border border-rule">
      {/* Drawn for a light page — held just below full brightness so it sits
          in the dark ground instead of glaring out of it. */}
      <Image
        src={image}
        alt={p.imageAlt}
        widths={[600, 900, 1280]}
        sizes="(min-width: 1280px) 1216px, 100vw"
        format="avif"
        loading="eager"
        class="block w-full brightness-[0.9] saturate-[0.94]"
      />
    </div>
  </section>

  {/* What it is */}
  <Section
    id="overview"
    eyebrow={p.whatIs.eyebrow}
    heading={p.whatIs.title}
  >
    <div class="max-w-[72ch]">
      {p.whatIs.body && <p class="text-fg-muted">{p.whatIs.body}</p>}

      {p.whatIs.intro && <p class="text-fg-muted">{p.whatIs.intro}</p>}

      {
        p.whatIs.points && (
          <dl class="mt-8 grid gap-px bg-rule md:grid-cols-2">
            {p.whatIs.points.map((point) => (
              <div class="bg-ground p-6">
                <dt class="text-h3 font-semibold">{point.title}</dt>
                <dd class="mt-3 text-[0.94rem] text-fg-muted">
                  {point.description}
                </dd>
              </div>
            ))}
          </dl>
        )
      }

      {p.whatIs.closing && <p class="mt-8 text-fg-muted">{p.whatIs.closing}</p>}
    </div>
  </Section>

  {/* Features */}
  <Section
    id="features"
    eyebrow={p.features.eyebrow}
    heading={p.features.title}
  >
    <ul class="grid gap-px bg-rule md:grid-cols-2 lg:grid-cols-3">
      {
        p.features.items.map((feature) => (
          <li class="flex flex-col bg-ground p-6 md:p-8">
            <h3 class="text-h3 font-semibold">{feature.title}</h3>
            <p class="mt-3 text-[0.94rem] text-fg-muted">
              {feature.description}
            </p>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* How it works */}
  <Section id="how-it-works" eyebrow={p.steps.eyebrow} heading={p.steps.title}>
    <ol class="max-w-[72ch]">
      {
        p.steps.items.map((step) => (
          <li class="grid gap-x-6 gap-y-2 border-t border-rule py-6 first:border-t-0 first:pt-0 md:grid-cols-[3.5rem_minmax(0,1fr)]">
            <p class="label tabular-nums text-fg-faint" aria-hidden="true">
              {step.step.padStart(2, "0")}
            </p>
            <div class="min-w-0">
              <h3 class="text-h3 font-semibold">{step.title}</h3>
              <p class="mt-2 text-[0.94rem] text-fg-muted">
                {step.description}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  {/* Requirements */}
  <Section
    id="requirements"
    eyebrow={p.requirements.eyebrow}
    heading={p.requirements.title}
  >
    <ul class="max-w-[72ch] space-y-3">
      {
        p.requirements.items.map((item) => (
          <li class="flex gap-3 text-fg-muted">
            <span
              class="mt-[0.55em] size-1 shrink-0 bg-signal"
              aria-hidden="true"
            />
            <span class="min-w-0">{item}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* FAQ — native disclosure, no JS */}
  <Section id="faq" eyebrow={p.faq.eyebrow} heading={p.faq.title}>
    <div class="max-w-[72ch]">
      {
        p.faq.items.map((item) => (
          <details class="group border-t border-rule last:border-b">
            <summary class="flex cursor-pointer list-none items-baseline gap-4 py-5 font-semibold marker:hidden [&::-webkit-details-marker]:hidden">
              <span
                class="label shrink-0 text-signal transition-transform group-open:rotate-90"
                aria-hidden="true"
              >
                &rsaquo;
              </span>
              <span class="min-w-0">{item.q}</span>
            </summary>
            <p class="pb-6 pl-8 text-[0.94rem] text-fg-muted">{item.a}</p>
          </details>
        ))
      }
    </div>
  </Section>

  {/* Bottom CTA */}
  <section class="border-t border-rule">
    <div class="mx-auto max-w-[1280px] px-5 py-16 md:px-8 md:py-24">
      <div class="max-w-[52ch]">
        <h2 class="text-h2 font-semibold">{p.ctaSection.title}</h2>
        <p class="mt-5 text-lede text-fg-muted">{p.ctaSection.description}</p>

        <a
          href={p.gumroadUrl}
          target="_blank"
          rel={ctaRel}
          data-umami-event="link_open"
          data-umami-event-name={p.umamiName}
          data-umami-event-type="product-bottom-cta"
          class="label mt-10 inline-block bg-signal px-6 py-4 text-signal-ink transition-colors hover:bg-signal-hover"
        >
          {p.ctaSection.button} &rarr;
        </a>
      </div>
    </div>
  </section>
</Base>
