---
import Base from "../../layouts/Base.astro";
import ScannerPanel from "../../components/scanner/ScannerPanel.astro";
import { scanner } from "../../i18n/scanner";

const lang = "de" as const;
const t = scanner[lang];
---

<Base
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  keywords={t.meta.keywords}
>
  <div class="mx-auto max-w-[1280px] px-5 py-16 md:px-8 md:py-24">
    <header class="max-w-[62ch]">
      <p class="label text-signal">{t.eyebrow}</p>
      <h1 class="mt-4 text-h2 font-semibold">{t.h1}</h1>
      <p class="mt-5 text-lede text-fg-muted">{t.lede}</p>
    </header>

    <div class="mt-12 min-w-0">
      <ScannerPanel lang={lang} />
    </div>
  </div>
</Base>
