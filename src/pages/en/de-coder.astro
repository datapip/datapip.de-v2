---
import Base from "../../layouts/Base.astro";
import DecoderPanel from "../../components/DecoderPanel.astro";
import { decoder } from "../../i18n/decoder";

const lang = "en" as const;
const t = decoder[lang];
---

<Base
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  keywords={t.meta.keywords}
>
  <div class="mx-auto max-w-[1280px] px-5 py-16 md:px-8 md:py-24">
    <header class="max-w-[62ch]">
      <p class="label text-signal">{t.eyebrow}</p>
      <h1 class="mt-4 text-h2 font-semibold">{t.h1}</h1>
      <p class="mt-5 text-lede text-fg-muted">{t.p}</p>
    </header>

    <div class="mt-12 max-w-[52rem]">
      <DecoderPanel lang={lang} />
    </div>
  </div>
</Base>
