---
import ToolPage from "../../components/ToolPage.astro";
import DecoderPanel from "../../components/DecoderPanel.astro";
import { decoder } from "../../i18n/decoder";

const lang = "en" as const;
const t = decoder[lang];
---

<ToolPage
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  keywords={t.meta.keywords}
  eyebrow={t.eyebrow}
  heading={t.h1}
  lede={t.p}
  faq={t.faq}
>
  <div class="mt-12 max-w-[52rem]">
    <DecoderPanel lang={lang} />
  </div>
</ToolPage>
