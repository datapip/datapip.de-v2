---
import ToolPage from "../../components/ToolPage.astro";
import ScannerPanel from "../../components/scanner/ScannerPanel.astro";
import { scanner } from "../../i18n/scanner";

const lang = "en" as const;
const t = scanner[lang];
---

<ToolPage
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  keywords={t.meta.keywords}
  eyebrow={t.eyebrow}
  heading={t.h1}
  lede={t.lede}
  faq={t.faq}
>
  <div class="mt-12 min-w-0">
    <ScannerPanel lang={lang} />
  </div>
</ToolPage>
